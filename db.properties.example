# Plantilla de configuración JDBC SIN secreto real.
# Este archivo sí puede permanecer en el repositorio.
#
# Para usarlo: copiarlo como db.properties en
#   Windows:      %USERPROFILE%\.ticka\db.properties
#   Linux/macOS:  ~/.ticka/db.properties
# y reemplazar db.password por la clave definida al ejecutar
# sql/00_usuario_aplicacion.sql. Ese archivo copiado NUNCA debe subirse a Git.

db.url=jdbc:mysql://localhost:3306/ticka?serverTimezone=America/El_Salvador&useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
db.user=ticka_app
db.password=CAMBIAR_LOCALMENTE
