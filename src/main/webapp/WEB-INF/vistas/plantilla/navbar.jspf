<%-- Barra superior común (marca, enlaces públicos y sesión) y menú lateral con
     las opciones del rol. El menú lateral solo aparece con sesión iniciada y
     fuera de la página de inicio (la cartelera pública). --%>
<c:set var="u" value="${sessionScope.usuarioAutenticado}" />
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<nav class="navbar">
    <a class="marca" href="${ctx}/">TICK<span>A</span></a>
    <a class="enlace ${paginaActiva == 'inicio' ? 'activo' : ''}" href="${ctx}/">Inicio</a>
    <a class="enlace" href="${ctx}/#cartelera">Cartelera</a>
    <div class="usuario">
        <c:choose>
            <c:when test="${empty u}">
                <a class="enlace" href="${ctx}/registro">Crear cuenta</a>
                <a class="boton acento chico" href="${ctx}/acceso">Iniciar sesión</a>
            </c:when>
            <c:otherwise>
                <c:if test="${paginaActiva == 'inicio'}">
                    <a class="boton acento chico" href="${ctx}${u.cliente ? '/cliente/boletos' : '/panel'}">${u.cliente ? 'Mis boletos' : 'Ir a mi panel'}</a>
                </c:if>
                <c:if test="${u.cliente}">
                    <c:set var="carritoAsientos" value="${sessionScope.carritoAsientos}" />
                    <a class="carrito" href="${ctx}/cliente/carrito"
                       title="${empty carritoAsientos ? 'Su carrito está vacío' : 'Pagar sus asientos reservados'}" aria-label="Carrito">
                        <%@ include file="/WEB-INF/vistas/plantilla/icono-carrito.jspf" %>
                        <c:if test="${not empty carritoAsientos}"><span class="carrito-cantidad">${carritoAsientos}</span></c:if>
                    </a>
                </c:if>
                <a class="enlace-perfil" href="${ctx}${u.cliente ? '/cliente/perfil' : '/perfil'}" title="Mi perfil"><c:out value="${u.nombre}" /> · <strong><c:out value="${u.rol.nombre}" /></strong></a>
                <form method="post" action="${ctx}/cerrar-sesion">
                    <input type="hidden" name="csrf" value="${sessionScope.csrf}">
                    <button type="submit" class="boton borde chico" style="color:#fff;border-color:#fff">Cerrar sesión</button>
                </form>
            </c:otherwise>
        </c:choose>
    </div>
</nav>
<c:if test="${not empty u and paginaActiva != 'inicio' and empty sinMenuLateral}">
    <aside class="menu-lateral" aria-label="Menú del rol">
        <a class="${paginaActiva == 'panel' ? 'activo' : ''}" href="${ctx}/panel">Panel</a>
        <c:if test="${u.cliente}">
            <p class="seccion">Mi cuenta</p>
            <a class="${paginaActiva == 'cartelera' ? 'activo' : ''}" href="${ctx}/cliente/cartelera">Cartelera</a>
            <a class="${paginaActiva == 'boletos' ? 'activo' : ''}" href="${ctx}/cliente/boletos">Mis boletos</a>
            <a class="${paginaActiva == 'perfil' ? 'activo' : ''}" href="${ctx}/cliente/perfil">Mi perfil</a>
        </c:if>
        <c:if test="${u.personalPuerta}">
            <p class="seccion">Control de acceso</p>
            <a class="${paginaActiva == 'validar' ? 'activo' : ''}" href="${ctx}/puerta/validar">Validar boletos</a>
            <a class="${paginaActiva == 'ocupacion' ? 'activo' : ''}" href="${ctx}/puerta/ocupacion">Ocupación en vivo</a>
            <a class="${paginaActiva == 'incidencias' ? 'activo' : ''}" href="${ctx}/puerta/incidencias">Incidencias</a>
        </c:if>
        <c:if test="${u.gestorEventos}">
            <p class="seccion">Organizador</p>
            <a class="${paginaActiva == 'eventos' ? 'activo' : ''}" href="${ctx}/organizador/eventos">Eventos</a>
            <a class="${paginaActiva == 'calendario' ? 'activo' : ''}" href="${ctx}/organizador/calendario">Calendario</a>
            <a class="${paginaActiva == 'recintos' ? 'activo' : ''}" href="${ctx}/organizador/recintos">Recintos y asientos</a>
            <a class="${paginaActiva == 'categorias' ? 'activo' : ''}" href="${ctx}/organizador/categorias">Categorías</a>
        </c:if>
        <c:if test="${u.administrador}">
            <p class="seccion">Administración</p>
            <a class="${paginaActiva == 'dashboard' ? 'activo' : ''}" href="${ctx}/admin/dashboard">Dashboard</a>
            <a class="${paginaActiva == 'reportes' ? 'activo' : ''}" href="${ctx}/reportes">Reportes</a>
            <a class="${paginaActiva == 'mostrador' ? 'activo' : ''}" href="${ctx}/admin/mostrador">Venta en mostrador</a>
            <a class="${paginaActiva == 'usuarios' ? 'activo' : ''}" href="${ctx}/admin/usuarios">Usuarios</a>
            <a class="${paginaActiva == 'clientes' ? 'activo' : ''}" href="${ctx}/admin/clientes">Clientes</a>
        </c:if>
        <c:if test="${not u.cliente}">
            <p class="seccion">Mi cuenta</p>
            <a class="${paginaActiva == 'perfil' ? 'activo' : ''}" href="${ctx}/perfil">Mi perfil</a>
        </c:if>
    </aside>
</c:if>
