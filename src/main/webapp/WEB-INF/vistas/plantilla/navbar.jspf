<%-- Barra de navegación común: los enlaces dependen del rol en sesión. --%>
<c:set var="u" value="${sessionScope.usuarioAutenticado}" />
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<nav class="navbar">
    <a class="marca" href="${ctx}/">TICK<span>A</span></a>
    <c:choose>
        <c:when test="${empty u}">
            <a class="enlace ${paginaActiva == 'inicio' ? 'activo' : ''}" href="${ctx}/">Inicio</a>
            <a class="enlace" href="${ctx}/#cartelera">Cartelera</a>
            <div class="usuario"><a class="boton acento chico" href="${ctx}/acceso">Iniciar sesión</a></div>
        </c:when>
        <c:otherwise>
            <a class="enlace ${paginaActiva == 'inicio' ? 'activo' : ''}" href="${ctx}/">Inicio</a>
            <a class="enlace ${paginaActiva == 'panel' ? 'activo' : ''}" href="${ctx}/panel">Panel</a>
            <c:if test="${u.administrador}">
                <a class="enlace ${paginaActiva == 'dashboard' ? 'activo' : ''}" href="${ctx}/admin/dashboard">Dashboard</a>
            </c:if>
            <c:if test="${u.gestorEventos}">
                <a class="enlace ${paginaActiva == 'eventos' ? 'activo' : ''}" href="${ctx}/organizador/eventos">Eventos</a>
                <a class="enlace ${paginaActiva == 'recintos' ? 'activo' : ''}" href="${ctx}/organizador/recintos">Recintos</a>
                <a class="enlace ${paginaActiva == 'categorias' ? 'activo' : ''}" href="${ctx}/organizador/categorias">Categorías</a>
            </c:if>
            <c:if test="${u.administrador}">
                <a class="enlace ${paginaActiva == 'usuarios' ? 'activo' : ''}" href="${ctx}/admin/usuarios">Usuarios</a>
                <a class="enlace ${paginaActiva == 'clientes' ? 'activo' : ''}" href="${ctx}/admin/clientes">Clientes</a>
                <a class="enlace ${paginaActiva == 'reportes' ? 'activo' : ''}" href="${ctx}/admin/reportes">Reportes</a>
            </c:if>
            <div class="usuario">
                <span><c:out value="${u.nombre}" /> · <strong><c:out value="${u.rol.nombre}" /></strong></span>
                <form method="post" action="${ctx}/cerrar-sesion">
                    <input type="hidden" name="csrf" value="${sessionScope.csrf}">
                    <button type="submit" class="boton borde chico" style="color:#fff;border-color:#fff">Cerrar sesión</button>
                </form>
            </div>
        </c:otherwise>
    </c:choose>
</nav>
